{
  "name": "codex-widget-for-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A resident Tauri desktop Codex-style agent widget with a streaming local daemon.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:services": "node scripts/dev-hot.mjs",
    "dev:auth-proxy": "node scripts/dev-auth-proxy.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "tauri build",
    "build:web": "npm run build:daemon && npm run build:daemon-bundle && npm run build:renderer && npm run build:node-runtime && npm run build:ocr-runtime && npm run build:pty-runtime",
    "build:daemon": "tsc -p tsconfig.node.json",
    "build:daemon-bundle": "node scripts/build-daemon-bundle.mjs",
    "build:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "build:ocr-runtime": "node scripts/prepare-ocr-runtime.mjs",
    "ocr:fetch-languages": "node scripts/fetch-ocr-languages.mjs",
    "build:pty-runtime": "node scripts/prepare-pty-runtime.mjs",
    "build:renderer": "vite build",
    "package:extension": "node scripts/package-browser-extension.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:browser-store-packet": "node scripts/prepare-browser-store-submission.mjs",
    "release:confirm-browser-store": "node scripts/confirm-browser-store-submission.mjs",
    "release:soak": "npm run build && node scripts/smoke-release-soak.mjs",
    "smoke": "npm run build:web && node scripts/smoke-daemon.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:all:live": "node scripts/smoke-all.mjs --include-live",
    "smoke:app-server": "npm run build:daemon && node scripts/smoke-codex-app-server.mjs",
    "smoke:app-server:live": "npm run build:daemon && node scripts/smoke-codex-app-server-live.mjs",
    "smoke:storage": "npm run build:daemon && node scripts/smoke-storage.mjs",
    "smoke:dom": "npm run build:daemon && node scripts/smoke-dom-provider.mjs",
    "smoke:browser-action": "npm run build:daemon && node scripts/smoke-browser-action.mjs",
    "smoke:browser-action:playwright": "npm run build:daemon && node scripts/smoke-browser-action-playwright.mjs",
    "smoke:browser-action:cdp": "npm run build:daemon && node scripts/smoke-browser-action-cdp.mjs",
