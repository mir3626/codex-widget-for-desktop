    "smoke:browser-view-graph-v2": "npm run build:daemon && node scripts/smoke-browser-view-graph-v2.mjs",
    "smoke:browser-perception": "npm run build:daemon && node scripts/smoke-browser-perception.mjs",
    "smoke:browser-perception:extension-command": "npm run build:daemon && node scripts/smoke-browser-perception-extension-command.mjs",
    "smoke:browser-perception:stabilization": "npm run build:daemon && node scripts/smoke-browser-perception-stabilization.mjs",
    "smoke:browser-action:fresh-context": "npm run build:daemon && node scripts/smoke-browser-action-fresh-context.mjs",
    "smoke:browser-interaction-transaction": "npm run build:daemon && node scripts/smoke-browser-interaction-transaction.mjs",
    "smoke:browser-action:transaction-clarification": "npm run build:daemon && node scripts/smoke-browser-interaction-transaction.mjs clarification",
    "smoke:browser-action:transaction-verification": "npm run build:daemon && node scripts/smoke-browser-interaction-transaction.mjs verification",
    "smoke:browser-action:transaction-concurrency": "npm run build:daemon && node scripts/smoke-browser-interaction-transaction.mjs concurrency",
    "dogfood:browser-action": "npm run build:daemon && node scripts/collect-browser-action-dogfood-evidence.mjs",
    "dogfood:browser-action:e2e": "npm run build:daemon && node scripts/collect-browser-action-e2e-dogfood-evidence.mjs",
    "dogfood:browser-action:live": "npm run build:daemon && node scripts/browser-action-live-runner.mjs",
    "dogfood:browser-action:live:real": "npm run build:daemon && node scripts/browser-action-live-runner.mjs --mode real",
    "dogfood:browser-action:live:widget-ui": "npm run build:daemon && node scripts/browser-action-live-runner.mjs --mode widget-ui",
    "dogfood:browser-view-graph-v2": "npm run build:daemon && node scripts/collect-browser-view-graph-v2-dogfood-evidence.mjs",
    "dogfood:browser-perception": "npm run build:daemon && node scripts/collect-browser-perception-dogfood-evidence.mjs",
    "dogfood:browser-bridge": "npm run build:daemon && node scripts/collect-browser-extension-bridge-dogfood-evidence.mjs",
    "dogfood:semantic-interface": "npm run build:daemon && node scripts/collect-semantic-interface-dogfood-evidence.mjs",
    "dogfood:semantic-memory": "npm run build:daemon && node scripts/collect-semantic-memory-dogfood-evidence.mjs",
    "smoke:daemon-reconnect": "npm run build:daemon && node scripts/smoke-daemon-reconnect.mjs",
    "smoke:extension": "node scripts/smoke-browser-extension.mjs",
    "smoke:browser-bridge": "npm run build:daemon && node scripts/smoke-browser-extension-bridge.mjs",
    "smoke:browser-native-host": "node scripts/smoke-browser-native-host.mjs",
    "smoke:browser-store": "node scripts/smoke-browser-store-readiness.mjs",
    "smoke:resident": "npm run build:daemon && node scripts/smoke-resident.mjs",
    "smoke:resident-soak": "npm run build:daemon && node scripts/smoke-resident-soak.mjs",
    "smoke:release-resources": "node scripts/smoke-release-resources.mjs",
    "smoke:release-launch": "node scripts/smoke-release-launch.mjs",
    "smoke:release-install": "node scripts/smoke-release-install.mjs",
