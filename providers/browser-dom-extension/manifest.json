{
  "manifest_version": 3,
  "name": "Codex Widget Browser Bridge",
  "version": "0.1.0",
  "description": "Bridge approved browser pages to the local Codex Widget daemon for safe Browser Action control.",
  "permissions": ["activeTab", "alarms", "bookmarks", "contentSettings", "debugger", "downloads", "history", "nativeMessaging", "scripting", "storage", "tabGroups", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Codex Widget Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
