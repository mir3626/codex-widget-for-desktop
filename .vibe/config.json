{
  "harnessVersion": "1.7.9",
  "harnessVersionInstalled": "1.7.9",
  "upstream": {
    "type": "git",
    "url": "https://github.com/mir3626/vibe-doctor",
    "ref": "^v1.7.9"
  },
  "orchestrator": "codex",
  "sprintRoles": {
    "planner": "codex",
    "generator": "codex",
    "evaluator": "codex"
  },
  "sprint": {
    "unit": "feature",
    "subAgentPerRole": true,
    "freshContextPerSprint": true
  },
  "providers": {
    "codex": {
      "command": ".\\.vibe\\harness\\scripts\\run-codex.cmd",
      "args": [
        "{prompt}"
      ],
      "env": {}
    }
  },
  "qa": {
    "preferScripts": [
      "test:unit",
      "test",
      "typecheck",
      "lint",
      "build"
    ]
  },
  "bundle": {
    "enabled": false,
    "dir": "dist-renderer",
    "limitGzipKB": 120,
    "excludeExt": [
      ".map"
    ],
    "policy": "automatic",
    "rationale": "automatic bundle policy added by harness migration"
  },
  "browserSmoke": {
    "enabled": false,
    "configPath": ".vibe/smoke.config.js"
  },
  "audit": {
    "everyN": 5,
    "projectRoots": [
      "src",
      "src-tauri"
    ],
    "prototypeLocThreshold": 5000
  },
  "mode": "human"
}
